# Supabase 项目配置：复制为 .env 后替换为真实值
# 不要在模板中提交真实密钥或数据库密码。
SUPABASE_PROJECT_REF=your-project-ref
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_PUBLISHABLE_KEY=your-supabase-publishable-key
SUPABASE_SECRET_KEY=your-supabase-secret-key
SUPABASE_STORAGE_BUCKET=script-assets

# 前端禁止持有 Supabase 连接变量；所有数据库和管理操作必须经由 FastAPI 后端。
NEXT_PUBLIC_USE_MOCK=false
NEXT_PUBLIC_WS_URL=ws://localhost:8000

# 后端和数据库迁移使用：DATABASE_URL 采用 Supabase Direct URI。
DATABASE_URL=postgresql://postgres:your-database-password@db.your-project-ref.supabase.co:5432/postgres
SUPABASE_DB_PASSWORD=your-database-password
DATABASE_POOLER_URL=postgresql://postgres.your-project-ref:your-database-password@aws-0-region.pooler.supabase.com:6543/postgres

# RAG 检索索引：生产使用 DashScope text-embedding-v4；deterministic 仅用于本地测试。
RAG_EMBEDDING_PROVIDER=dashscope
RAG_EMBEDDING_DIMENSIONS=1024
RAG_DASHSCOPE_EMBEDDING_MODEL=text-embedding-v4
DASHSCOPE_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
DASHSCOPE_API_KEY=your-dashscope-api-key

# NPC 文本生成：使用 OpenAI-compatible Chat Completions 接口。
NPC_GENERATION_PROVIDER=openai_compatible
OPENAI_API_KEY=your-compatible-api-key
OPENAI_BASE_URL=https://your-compatible-provider.example/v1
OPENAI_MODEL=your-compatible-model-id
NPC_OPENAI_MAX_TOKENS=512
NPC_OPENAI_TIMEOUT_SECONDS=20
