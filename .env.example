# Supabase 项目配置：复制为 .env 后替换为真实值
# 不要在模板中提交真实密钥或数据库密码。
SUPABASE_PROJECT_REF=your-project-ref
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_PUBLISHABLE_KEY=your-supabase-publishable-key
SUPABASE_SECRET_KEY=your-supabase-secret-key
SUPABASE_STORAGE_BUCKET=script-assets

# Supabase Auth 前端公开配置（仅用于匿名登录；不是数据库或管理密钥）
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=your-supabase-publishable-key
# 旧单人前端默认使用 Mock；真实 API 联调时可设为 false。
# Makefile 的 dev/dev-web 默认仍会显式使用 true，避免本地 .env 意外关闭 Mock。
NEXT_PUBLIC_USE_MOCK=true
NEXT_PUBLIC_WS_URL=ws://localhost:8000

# 后端和数据库迁移使用：DATABASE_URL 采用 Supabase Direct URI。
DATABASE_URL=postgresql://postgres:your-database-password@db.your-project-ref.supabase.co:5432/postgres
SUPABASE_DB_PASSWORD=your-database-password
DATABASE_POOLER_URL=postgresql://postgres.your-project-ref:your-database-password@aws-0-region.pooler.supabase.com:6543/postgres

# 多人房间大厅发布开关；生产默认关闭，本地 make dev 会显式开启。
MULTIPLAYER_V1=false
# 两名同 IP 玩家通过 HTTP polling + presence 同场时，默认 API 网关预算为 360 次/分钟。
RATE_LIMIT_PER_MINUTE=360
ROOM_EVENTS_V1=false
AI_DM_V1=false

# RAG 检索索引：生产使用 DashScope text-embedding-v4；deterministic 仅用于本地测试。
RAG_EMBEDDING_PROVIDER=dashscope
RAG_EMBEDDING_DIMENSIONS=1024
RAG_DASHSCOPE_EMBEDDING_MODEL=text-embedding-v4
DASHSCOPE_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
DASHSCOPE_API_KEY=your-dashscope-api-key

# NPC 文本生成：使用 OpenAI-compatible Chat Completions 接口。
NPC_GENERATION_PROVIDER=openai_compatible
OPENAI_API_KEY=your-compatible-api-key
OPENAI_BASE_URL=https://your-compatible-provider.example/v1
OPENAI_MODEL=your-compatible-model-id
NPC_OPENAI_MAX_TOKENS=512
NPC_OPENAI_TIMEOUT_SECONDS=20
